# PAYSTACK_CALLBACK_URL=https://your-app.example/payment-return
# For a dedicated real staging project, remove BOTH emulator variables and set:
# FIREBASE_PROJECT_ID=your-isolated-staging-project
# PAYSTACK_TEST_PROJECT_ID=your-isolated-staging-project
# SERVERPOD_API_SERVER_PUBLIC_HOST=api.your-app.example
# SERVERPOD_WEB_SERVER_PUBLIC_HOST=hooks.your-app.example
# Use Application Default Credentials; never commit credential files.
