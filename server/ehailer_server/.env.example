# Reference only: Dart does not load this file automatically.
# Supply secrets through your process environment or hosting secret manager.
FIREBASE_PROJECT_ID=demo-ehailer
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
PAYSTACK_MODE=test
# Empty disables checkout. Keep the real sk_test_ value outside Git and Flutter.
PAYSTACK_SECRET_KEY=
