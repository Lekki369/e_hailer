# PRIVATE signing only. Copy to android/.env, chmod 600, and keep the keystore local.
# These values enter Gradle's process environment, NEVER Flutter Dart defines.
# STORE_FILE is absolute, or relative to the android/ directory.
E_HAILER_ANDROID_STORE_FILE=
E_HAILER_ANDROID_STORE_PASSWORD=
E_HAILER_ANDROID_KEY_ALIAS=
E_HAILER_ANDROID_KEY_PASSWORD=
