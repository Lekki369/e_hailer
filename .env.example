# PUBLIC client configuration only: compiled values are extractable from the app.
# Copy to .env (ignored). Server secrets belong in server/ehailer_server/.env.
# The default runs against demo emulators. Use --debug for emulator builds.
USE_FIREBASE_EMULATORS=true
FIREBASE_EMULATOR_HOST=127.0.0.1
FIREBASE_PROJECT_ID=demo-ehailer
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_MEASUREMENT_ID=
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_PACKAGE_NAME=com.example.e_hailer
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=com.example.eHailer
E_HAILER_API_URL=http://127.0.0.1:8787/
E_HAILER_PUBLIC_URL=
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=
